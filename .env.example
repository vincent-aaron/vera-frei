# ---------------- Discord (required) ----------------
# Developer Portal -> your app -> Bot -> Reset Token. NEVER share it or commit it.
DISCORD_TOKEN=
# Your Discord user ID (Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID).
# The owner gets email, job mail and the private channels. Everyone can use Vera.
DISCORD_OWNER_ID=
# Optional: your server ID, so slash commands appear instantly (otherwise up to an hour).
DISCORD_GUILD_ID=
# Channel Vera posts in (created automatically if the bot may manage channels).
VERA_MAIN_CHANNEL=vera-multiboards-application
# true = replies only visible to the person who asked; false = everyone can see them
VERA_PRIVATE_REPLIES=false
VERA_TIMEZONE=Asia/Manila

# ---------------- Free AI (optional but recommended) ----------------
# Set any of these. They're tried in this order, moving on when one is rate-limited.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://build.nvidia.com
NVIDIA_API_KEY=
# Free key: https://openrouter.ai/settings/keys (only free ":free" models are used).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,poolside/laguna-s-2.1:free,openrouter/free

# ---------------- Other people's application rounds ----------------
# Limits for everyone except the owner, because runs share the owner's PC and connection.
VERA_SHARED_MAX_PER_RUN=5
VERA_SHARED_MAX_PER_DAY=10

# ---------------- Cold email and job mail tracking (optional, owner only) ----------------
# Your own Gmail and an app password: https://myaccount.google.com/apppasswords
OUTREACH_EMAIL=
OUTREACH_APP_PASSWORD=
OUTREACH_MAX_PER_DAY=20
